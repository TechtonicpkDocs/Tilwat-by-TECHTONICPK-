<?xml version="1.0" encoding="utf-8"?>
<!-- Session history is local-only: excluded from cloud backup and from
     device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
